      "Bash(node_modules/.bin/tsc --version)",
      "Bash(node_modules/.bin/tsc --noEmit)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python -m pytest:*)",
      "Bash(poetry run pytests:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(npm test:*)",
      "Bash(yarn test:*)",
      "Bash(yarn test:unit:*)",
      "Bash(yarn test:coverage:*)",
      "Bash(cargo test:*)",
      "Bash(python -m py_compile:*)",
      "Bash(yarn build-check:*)",
      "Bash(yarn run type-check)",
      "Bash(yarn run type-check:*)",
      "Bash(yarn run lint)",
      "Bash(yarn run lint:*)",
      "Bash(yarn run tsc:*)",
      "Bash(yarn type-check:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn eslint:*)",
      "Bash(yarn tsc:*)",
      "Bash(yarn fix:*)",
      "Bash(yarn build:*)",
      "Bash(yarn build-only *)",
      "Bash(yarn test:unit)",
      "Bash(yarn test:e2e:pw:*)",
      "Bash(yarn run test:unit)",
      "Bash(yarn run test:e2e:pw:*)",
      "Bash(cargo check:*)",
      "Bash(corepack yarn@4.9.2 add:*)",
      "Bash(yarn add:*)",
      "Bash(uv add:*)",
      "Bash(echo \"exit: $?\")",
      "Bash(git add:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git config user.name)",
      "Bash(git config user.email)",
      "Bash(git config --local user.name)",
      "Bash(git config --local user.email)",
      "Bash(git config --global user.name)",
      "Bash(git config --global user.email)",
      "Bash(git branch --show-current)",
      "Bash(git ls-tree:*)",
      "Bash(git check-ignore:*)",
      "Bash(git fetch:*)",
      "Bash(git stash:*)",
      "Bash(git commit -F ai/git/pending-commit.md)",
      "Bash(git commit --amend -F ai/git/pending-commit.md)",
      "Bash(git commit --amend --reset-author --no-edit)",
      "Bash(make commit:*)",
      "Bash(rm ai/git/pending-commit.md || echo 'was gone')",
      "Bash(rm ai/git/pending-commit.md)",
      "Bash(git lfs install)",
      "Bash(command -v pre-commit)",
      "Bash(git rebase --continue)",
      "Bash(pkill -f \"vite\")",
      "Bash(tree)",
      "Skill(commit-with-lplp-style)",
      "Skill(/commit-with-lplp-style)",
      "Read(ai/skills/commit-with-lplp-style/SKILL.md)",
      "Read(./ai/skills/commit-with-lplp-style/SKILL.md)",
      "Bash(uv run --project scripts/°base python -m unittest:*)",
      "Bash(uv run --project \"scripts/°base\" python -m unittest:*)",
      "Bash(python3 scripts/°base/ai/hooks/save-prompt/hook.py)",
      "Bash(python3 -m pytest scripts/°base/tests/test_permission_check.py:*)",
      "Bash(python3 -m pytest scripts/°base/init/checkout.sh)",
      "Bash(GIT_SEQUENCE_EDITOR=/tmp/git-rebase-todo.sh git *)",
      "Bash(uv run fastapi --help)",
      "Bash(python3 \"scripts/°base/ai/settings/sync.py\")",
      "Bash(python3 scripts/°base/ai/settings/sync.py:*)",
      "Bash(python scripts/°base/ai/settings/sync.py:*)",
      "Bash(uv run --directory scripts/°base python -m ai.settings.sync:*)",
      "Bash(./scripts/°base/ai/settings/sync.py)",
      "Bash(GIT_SEQUENCE_EDITOR=/tmp/git-rebase-todo.sh git rebase *)",
      "Bash(env UV_CACHE_DIR=/tmp/uv-cache DOWNLOAD_LINK_LIVE=1 uv run --project scripts/°base python -m unittest scripts/°base/tests/test_download_link_live.py -v)",
      "Bash(env UV_CACHE_DIR=/tmp/uv-cache ./scripts/°base/ai/references/download-link.py:*)",
      "Bash(./scripts/°base/ai/references/download-link.py:*)",
      "Bash(../scripts/°base/init/link-subproject-claude.sh)",
      "Bash(mv .claude/settings.local.json \".claude.settings.local.json.$\\(date +%Y-%m-%d\\).bak\")",
      "mcp__bugsink__list_projects",
      "mcp__bugsink__list_issues",
      "mcp__bugsink__get_issue",
      "Bash(echo \"---\")",
      "Bash(echo ---)",
      "Bash(echo '---')"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/env.php*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)"
    ]
  },
  "enabledPlugins": {
    "openai-developers@openai-developers": true,
    "skill-creator@claude-plugins-official": true
  },
  "enabledMcpjsonServers": [],
  "disabledMcpjsonServers": [
    "bugsink"
  ]
}
