{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Bash|shell|unified_exec",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/permission-check.py\"",
            "timeout": 5,
            "statusMessage": "Checking command policy..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/settings/sync.py\"",
            "statusMessage": "Syncing AI tool settings",
            "async": true
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/°base/init/checkout.sh\"",
            "statusMessage": "Setting up git hooks",
            "async": true
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/record-memory/hook.py\"",
            "statusMessage": "Syncing memory hardlinks",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|request_user_input|ask_user",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/°base/git/hooks/tool_path.sh\" uv run --project \"$(git rev-parse --show-toplevel)/scripts/°base\" python \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-decision/hook.py\" 'claude'",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|shell|unified_exec",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/record-memory/hook.py\"",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit|ExitPlanMode|create|edit|exit_plan_mode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-plan/hook.py\" 'claude'",
            "async": true
          }
        ]
      },
      {
        "matcher": "TodoWrite|update_todo|TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-plan/hook.py\" 'claude'",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-plan/hook.py\" 'claude'",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-prompt/hook.py\" 'claude'",
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(yarn)",
      "Bash(make)",
      "Bash(which python)",
      "Bash(python --version)",
      "Bash(pip show:*)",
      "Bash(pip3 show:*)",
      "Bash(uv pip show:*)",
      "Bash(pip index versions:*)",
      "Bash(pip3 index versions:*)",
      "Bash(uv --version)",
      "Bash(uv python list)",
      "Bash(uv pip index versions:*)",
      "Bash(nvm use:*)",
      "Bash(poetry install:*)",
      "Bash(yarn install:*)",
      "Bash(corepack yarn@4.9.2 install:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock *)",
      "Bash(npx vue-tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc *)",
